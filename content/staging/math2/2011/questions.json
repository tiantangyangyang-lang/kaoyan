  "questions": [
    {
      "stableId": "math2-2011-q01",
      "sourceYear": 2011,
      "subjectCode": "math2",
      "type": "multiple_choice",
      "questionNumber": 1,
      "stem": "已知当 x → 0 时， $f ( x ) = 3 \\sin x - \\sin 3 x$ 与 $c x ^ { k }$ 是等价无穷小，则· · · · · · · ·( )",
      "options": [
        {
          "label": "A",
          "value": "k = 1, c = 4"
        },
        {
          "label": "B",
          "value": "$k = 1 , c = - 4 .$"
        },
        {
          "label": "C",
          "value": "$k = 3 , c = 4$"
        },
        {
          "label": "D",
          "value": "k = 3, c = −4"
        }
      ],
      "answer": "C",
      "answerStatus": "sourced_from_aggregate",
      "explanation": "解. 应选(C)．由三倍角公式和等价无穷小量代换得\n\n$$\n\\begin{array}{l} 1 = \\lim _ {x \\rightarrow 0} \\frac {3 \\sin x - \\sin 3 x}{c x ^ {k}} = \\lim _ {x \\rightarrow 0} \\frac {3 \\sin x - (3 \\sin x - 4 \\sin^ {3} x)}{c x ^ {k}} \\\\ = \\lim _ {x \\rightarrow 0} \\frac {4 \\sin^ {3} x}{c x ^ {k}} = \\lim _ {x \\rightarrow 0} \\frac {4 x ^ {3}}{c x ^ {k}}. \\\\ \\end{array}\n$$\n\n所以 $c = 4 , k = 3$",
      "explanationStatus": "sourced_from_aggregate",
      "reviewStatus": "needs_human_review",
      "finalizationStatus": "blocked",
      "knowledgePoints": [],
      "anomalies": [],
      "sourceEvidence": [
        {
